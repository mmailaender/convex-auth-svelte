{
	"name": "@mmailaender/convex-auth-svelte",
	"author": "Micha Mailaender",
	"version": "0.1.4",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mmailaender/convex-auth-svelte.git"
	},
	"type": "module",
	"files": [
		"dist/internal",
		"dist/methods",
		"dist/svelte",
		"dist/sveltekit",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/convex",
		"!dist/demo",
		"src/lib/internal",
		"src/lib/methods",
		"src/lib/svelte",
		"src/lib/sveltekit",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev:frontend": "vite dev",
		"dev:backend": "npx convex dev",
		"dev": "concurrently --kill-others --prefix-colors blue,yellow --names 'svelte,convex' 'pnpm dev:frontend' 'pnpm dev:backend'",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepack": "pnpm package",
		"lint:package": "pnpm pack --out /tmp/convex-auth-svelte-package.tgz && publint /tmp/convex-auth-svelte-package.tgz",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish && git push --follow-tags"
	},
	"exports": {
		"./svelte": {
			"types": "./dist/svelte/index.svelte.d.ts",
			"svelte": "./dist/svelte/index.svelte.js",
			"default": "./dist/svelte/index.svelte.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"svelte": "./dist/sveltekit/index.js",
			"default": "./dist/sveltekit/index.js"
		},
		"./sveltekit/server": {
			"types": "./dist/sveltekit/server/index.d.ts",
			"import": "./dist/sveltekit/server/index.js"
		},
		"./methods/username-password": {
			"types": "./dist/methods/username-password.svelte.d.ts",
			"svelte": "./dist/methods/username-password.svelte.js",
			"default": "./dist/methods/username-password.svelte.js"
		},
		"./methods/email-password": {
			"types": "./dist/methods/email-password.svelte.d.ts",
			"svelte": "./dist/methods/email-password.svelte.js",
			"default": "./dist/methods/email-password.svelte.js"
		},
		"./methods/username-passkey": {
			"types": "./dist/methods/username-passkey.svelte.d.ts",
			"svelte": "./dist/methods/username-passkey.svelte.js",
			"default": "./dist/methods/username-passkey.svelte.js"
		},
		"./methods/oauth": {
			"types": "./dist/methods/oauth.d.ts",
			"svelte": "./dist/methods/oauth.js",
			"default": "./dist/methods/oauth.js"
		},
		"./methods/google": {
			"types": "./dist/methods/google.d.ts",
			"svelte": "./dist/methods/google.js",
			"default": "./dist/methods/google.js"
		},
		"./methods/github": {
			"types": "./dist/methods/github.d.ts",
			"svelte": "./dist/methods/github.js",
			"default": "./dist/methods/github.js"
		},
		"./methods/apple": {
			"types": "./dist/methods/apple.d.ts",
			"svelte": "./dist/methods/apple.js",
			"default": "./dist/methods/apple.js"
		}
	},
	"devDependencies": {
		"@ark-ui/svelte": "^5.25.1",
		"@changesets/cli": "^2.31.0",
		"@convex-dev/auth": "^2.0.0",
		"@convex-dev/resend": "0.2.9",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lucide/svelte": "^1.73.0",
		"@playwright/test": "^1.60.0",
		"@skeletonlabs/skeleton": "^5.0.4",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.64.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^24.13.1",
		"@zxcvbn-ts/core": "^4.3.0",
		"@zxcvbn-ts/language-common": "^4.2.0",
		"@zxcvbn-ts/language-en": "^4.1.2",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"convex": "^1.50.0",
		"convex-svelte": "^0.15.1",
		"dotenv": "^17.4.2",
		"jose": "^6.2.3",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"runed": "^0.37.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"svelte-easy-crop": "^5.0.1",
		"svelte-sonner": "^1.2.3",
		"svelte-toolbelt": "^0.10.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"@convex-dev/auth": "^2.0.0",
		"@sveltejs/kit": "^2.21.0",
		"convex": "^1.48.0",
		"convex-svelte": "^0.15.0",
		"svelte": "^5.38.5"
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	}
}
